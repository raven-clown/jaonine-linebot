# --- LINE Messaging API ---
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_ID=

# --- LIFF (ฟอร์มสร้างงาน) ---
# สร้าง LIFF app ใน LINE Developers Console โดยตั้ง Endpoint URL เป็น https://<your-render-app>.onrender.com/liff/create-task
# แล้วเอา LIFF ID มาใส่ตรงนี้ ถ้าเว้นว่างไว้ บอทจะ fallback ไปใช้ flow พิมพ์ทีละขั้นตอนแบบเดิมแทน
LIFF_ID=

# --- Database (Supabase หรือ Neon, Postgres free tier) ---
# หมายเหตุสำคัญ: ถ้า deploy บน Render/Fly (network เป็น IPv4-only) ห้ามใช้ direct connection
# (db.<ref>.supabase.co:5432 เป็น IPv6-only บน free tier) ต้องใช้ "Session pooler" แทน
# (ดูได้จาก Supabase Dashboard > Connect > Session pooler) รูปแบบ:
# postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# --- App ---
PORT=3000
TZ=Asia/Bangkok

# หมายเหตุ: ระยะเวลาแจ้งเตือนล่วงหน้าก่อนเดดไลน์ตอนนี้ตั้งได้ต่อคนผ่านคำสั่ง "ตั้งแจ้งเตือน" ในแชท
# (ดูค่าเริ่มต้น/ตัวเลือกทั้งหมดที่ src/notifications/reminder-schedule.util.ts) ไม่ต้องตั้งผ่าน .env แล้ว

# แจ้งเตือนซ้ำทุกกี่นาทีเมื่อเลย deadline แล้วยังไม่เสร็จ
NOTIFY_OVERDUE_REPEAT_MIN=180
# scheduler รันทุกกี่นาที
SCHEDULER_INTERVAL_MIN=1

# เก็บงานที่เสร็จ/ยกเลิกไว้กี่วันก่อนลบถาวรอัตโนมัติ (กันข้อมูลบวมบน Supabase free tier)
# ตั้งเป็น 0 หรือติดลบเพื่อปิดการลบอัตโนมัติ
TASK_RETENTION_DAYS=365
