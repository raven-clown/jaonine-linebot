# --- LINE Messaging API ---
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# --- Database (Supabase หรือ Neon, Postgres free tier) ---
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# --- App ---
PORT=3000
BOT_NAME=เจ้านาย
TZ=Asia/Bangkok

# ก่อน deadline กี่นาทีให้แจ้งเตือนล่วงหน้า (ค่าเริ่มต้น 60 นาที)
NOTIFY_BEFORE_DEADLINE_MIN=60
# แจ้งเตือนซ้ำทุกกี่นาทีเมื่อเลย deadline แล้วยังไม่เสร็จ
NOTIFY_OVERDUE_REPEAT_MIN=180
# scheduler รันทุกกี่นาที
SCHEDULER_INTERVAL_MIN=1
