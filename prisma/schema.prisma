// เจ้านาย (JaoNine) — LINE Task Bot
// Schema ตาม docs/03-database-schema.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  lineUserId   String   @unique
  displayName  String
  plan         Plan     @default(FREE) // ระดับผู้ใช้ — กำหนดลิมิตงานค้างสูงสุด (ยังไม่เชื่อมระบบรับเงินจริง)
  createdAt    DateTime @default(now())

  memberships          GroupMember[]
  createdTasks         Task[]                 @relation("CreatedTasks")
  assignedTasks        Task[]                 @relation("AssignedTasks")
  taskLogs             TaskLog[]
  notificationPref     NotificationPreference?
  receivedNotifications NotificationSchedule[] @relation("NotificationRecipient")
}

enum Plan {
  FREE
  PRO
}

model Group {
  id          String   @id @default(cuid())
  lineGroupId String   @unique
  name        String
  createdAt   DateTime @default(now())

  members     GroupMember[]
  tasks       Task[]
}

model GroupMember {
  id                   String   @id @default(cuid())
  groupId              String
  userId               String
  role                 Role     @default(MEMBER)
  maxOpenTasksOverride Int?     // ถ้าตั้งไว้ จะข้ามลิมิตตาม Plan ไปใช้ค่านี้แทน (ปรับเป็นรายคนได้)
  joinedAt             DateTime @default(now())

  group        Group    @relation(fields: [groupId], references: [id])
  user         User     @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
}

enum Role {
  ADMIN
  MEMBER
}

model Task {
  id             String         @id @default(cuid())
  groupId        String
  creatorId      String
  title          String
  description    String?
  priority       Priority       @default(MEDIUM)
  deadline       DateTime?
  assignmentMode AssignmentMode
  assignedToId   String?
  status         TaskStatus     @default(OPEN)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  group          Group          @relation(fields: [groupId], references: [id])
  creator        User           @relation("CreatedTasks", fields: [creatorId], references: [id])
  assignedTo     User?          @relation("AssignedTasks", fields: [assignedToId], references: [id])
  logs           TaskLog[]
  notifications  NotificationSchedule[]

  @@index([status, updatedAt]) // ใช้กับ job ลบงานเก่าที่ DONE/CANCELLED เกินระยะเก็บข้อมูล
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum AssignmentMode {
  EXCLUSIVE  // มอบให้คนเดียว คนอื่น claim ไม่ได้
  OPEN_CLAIM // ใครก็ได้ในกลุ่มกดรับ คนแรกได้ไป
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

model TaskLog {
  id        String    @id @default(cuid())
  taskId    String
  actorId   String
  action    LogAction
  createdAt DateTime  @default(now())

  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor     User      @relation(fields: [actorId], references: [id])
}

enum LogAction {
  CREATED
  ASSIGNED
  UNASSIGNED
  CLAIMED
  UNCLAIMED
  COMPLETED
  CANCELLED
}

model NotificationSchedule {
  id              String    @id @default(cuid())
  taskId          String
  type            NotifType
  scheduledAt     DateTime
  sentAt          DateTime?
  recipientUserId String?   // ผู้รับเฉพาะราย (null = broadcast เข้ากลุ่ม เช่น CLAIMED_BROADCAST)

  task        Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  recipient   User? @relation("NotificationRecipient", fields: [recipientUserId], references: [id])

  @@index([scheduledAt])
  @@index([sentAt])
  @@index([recipientUserId])
}

enum NotifType {
  ASSIGNED_ALERT    // แจ้งทันทีที่ถูกมอบหมาย
  BEFORE_DEADLINE   // เตือนล่วงหน้าก่อนถึง deadline (หลายจุดตาม preference ของแต่ละคน)
  OVERDUE_REPEAT    // เตือนซ้ำเมื่อเลย deadline ยังไม่เสร็จ
  CLAIMED_BROADCAST // แจ้งกลุ่มว่างานถูก claim ไปแล้ว
}

/// การตั้งค่าการแจ้งเตือนเรื่องเดดไลน์ของผู้ใช้แต่ละคน (ตั้งเองได้ผ่านคำสั่ง "ตั้งแจ้งเตือน")
model NotificationPreference {
  id               String       @id @default(cuid())
  userId           String       @unique
  mode             ReminderMode @default(DEFAULT_SCHEDULE)
  customOffsetsMin Int[]        @default([]) // ใช้เมื่อ mode = CUSTOM: นาทีก่อนเดดไลน์ที่จะเตือน (เรียงมาก->น้อย)
  updatedAt        DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id])
}

enum ReminderMode {
  DEFAULT_SCHEDULE // ใช้ตารางเตือนมาตรฐาน (1 เดือน, 15/12/9/7/5/3/1 วัน, 12/6/3/1 ชม. ก่อนเดดไลน์)
  DEADLINE_ONLY    // เตือนแค่ตอนถึงเวลาเดดไลน์เท่านั้น ไม่มีเตือนล่วงหน้า
  CUSTOM           // ใช้ customOffsetsMin ที่ผู้ใช้กำหนดเอง
  OFF              // ปิดแจ้งเตือนเรื่องเดดไลน์ทั้งหมด (ก่อนและหลังหมดเวลา)
}
